{
    // 题目文件保存目录。题目（.md / .py）和缓存（.cache/）都放在这里。
    // Where problem files (.md / .py) and the cache (.cache/) are saved.
    "working_dir": "~/leetcode",

    // 拉题时的默认语言。支持的 slug：
    // Default language slug used when fetching a problem. Supported slugs:
    //   python3, python, java, cpp, c, csharp, javascript,
    //   typescript, golang, rust, kotlin, swift, scala, ruby, php
    "default_lang": "python3",

    // 题目描述语言：zh = 中文，en = 英文。**和 site 无关**：英文站（com）没有中文内容，
    // 所以 site=com + language=zh 时中文会回滚成英文。题目列表（标题）缓存按语言分成
    // problem_list_zh.json / problem_list_en.json 两份，cn 能同时产出两份，com 只有英文那份。
    // Problem language: "zh" or "en" — independent of `site`. leetcode.com has no Chinese
    // content, so com + zh falls back to English. The title list is cached per language
    // (problem_list_zh.json / problem_list_en.json); only cn can produce the Chinese one.
    "language": "zh",

    // 站点：cn = 力扣中国（leetcode.cn），com = leetcode.com。
    // Cookie 和每题缓存（problems[_com]/ 里的 JSON）按站点分开存，两个站各要 Login 一次。
    // Site: "cn" for leetcode.cn, "com" for leetcode.com.
    // Cookies and per-problem caches are stored per site: run Login once per site.
    "site": "cn",

    // leetcode.com 的提交 / Run Code 后面有 Cloudflare 人机挑战。cf_clearance 这个 Cookie 是跟
    // 「拿到它的浏览器 UA」绑定的，所以想让粘贴进来的 cf_clearance 生效，就把你浏览器的
    // User-Agent 原样粘到这里（要和复制 Cookie 的那个浏览器一致）。留空则用内置的 Chrome UA。
    // Cloudflare binds cf_clearance to the User-Agent that obtained it; paste your browser's
    // exact User-Agent here to make a pasted cf_clearance cookie acceptable. Empty = built-in UA.
    "browser_ua": "",

    // 题目列表 / 题集缓存的有效天数，超过后会自动刷新。
    // How many days the problem-list / study-plan cache stays fresh.
    "cache_age_days": 7,

    // 离线 Run 的时间上限（秒）。超时或死循环会被杀掉。
    // Time limit (seconds) for the offline Run; infinite loops are killed.
    "run_timeout": 1
}
